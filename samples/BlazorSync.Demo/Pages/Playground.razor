@page "/playground"
@inject DemoWorkspace Workspace
@implements IDisposable

<PageTitle>Sync Playground · BlazorSync</PageTitle>

<div class="page-head">
    <h1>Sync Playground</h1>
    <p class="lede">
        Each panel is an independent device with its own local store, clock and offline state — all
        syncing to one shared cloud. Edit notes, toggle devices offline, then sync to watch changes
        and conflicts propagate.
    </p>
</div>

<div class="toolbar">
    <button class="btn" @onclick="SyncAll">⟲ Sync all online</button>
    <button class="btn ghost" @onclick="() => Workspace.AddDevice()" disabled="@(Workspace.Devices.Count >= 6)">+ Add device</button>
    <button class="btn ghost" @onclick="() => Workspace.RemoveLastDevice()" disabled="@(Workspace.Devices.Count <= 1)">− Remove device</button>
    <span class="spacer"></span>
    <button class="btn ghost danger" @onclick="() => Workspace.Reset()">Reset workspace</button>
</div>

<div class="device-grid">
    @foreach (var device in Workspace.Devices)
    {
        <DevicePanel @key="device.NodeId" Device="device" Workspace="Workspace" />
    }
</div>

<div class="bottom-grid">
    <ServerInspector Workspace="Workspace" />
    <ActivityLogView Log="Workspace.Log" />
</div>

@code {
    protected override void OnInitialized() => Workspace.Changed += OnChanged;

    public void Dispose() => Workspace.Changed -= OnChanged;

    private async void OnChanged() => await InvokeAsync(StateHasChanged);

    private async Task SyncAll() => await Workspace.SyncAllAsync();
}
