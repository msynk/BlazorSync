@page "/conflicts"
@implements IDisposable

<PageTitle>Conflict Lab · Bsync</PageTitle>

<div class="page-head">
    <h1>Conflict Lab</h1>
    <p class="lede">
        A scripted scenario: two devices edit the same note while offline, then sync. Pick the
        resolving device's strategy and step through to see exactly how Bsync reconciles the
        divergent writes.
    </p>
</div>

<div class="lab-steps">
    <button class="btn @(_step == 0 ? "primary" : "ghost")" disabled="@(_step != 0)" @onclick="Step1CreateAndShare">
        1 · Create &amp; share a note
    </button>
    <button class="btn @(_step == 1 ? "primary" : "ghost")" disabled="@(_step != 1)" @onclick="Step2EditOffline">
        2 · Both edit it offline
    </button>
    <div class="lab-strategy">
        <label>Phone resolves with:</label>
        <select @bind="_strategy" disabled="@(_step != 2)">
            @foreach (var s in Enum.GetValues<ConflictStrategy>())
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>
    <button class="btn @(_step == 2 ? "primary" : "ghost")" disabled="@(_step != 2)" @onclick="Step3Resolve">
        3 · Sync &amp; resolve
    </button>
    <button class="btn ghost danger" @onclick="Reset">Reset</button>
</div>

@if (!string.IsNullOrEmpty(_narrative))
{
    <div class="narrative">@_narrative</div>
}

@if (_outcome is not null)
{
    <div class="outcome">
        <strong>Outcome:</strong> @_outcome
    </div>
}

<div class="lab-grid">
    <div class="lab-col" style="--accent:@DisplayHelpers.ColorFor(_deviceA.NodeId)">
        <h3>💻 @_deviceA.Name <span class="@(_deviceA.IsOnline ? "tag-on" : "tag-off")">@(_deviceA.IsOnline ? "online" : "offline")</span></h3>
        @RenderNotes(_notesA)
    </div>

    <div class="lab-col" style="--accent:@DisplayHelpers.ColorFor(_deviceB.NodeId)">
        <h3>📱 @_deviceB.Name <span class="@(_deviceB.IsOnline ? "tag-on" : "tag-off")">@(_deviceB.IsOnline ? "online" : "offline")</span></h3>
        @RenderNotes(_notesB)
    </div>

    <div class="lab-col cloud-col">
        <h3>☁️ Cloud</h3>
        @RenderNotes(_serverNotes)
    </div>
</div>

<ActivityLogView Log="_log" />

@code {
    private readonly ActivityLog _log = new();
    private InMemorySyncServer<DemoNote> _server = null!;
    private DeviceContext _deviceA = null!;
    private DeviceContext _deviceB = null!;

    private IReadOnlyList<DemoNote> _notesA = Array.Empty<DemoNote>();
    private IReadOnlyList<DemoNote> _notesB = Array.Empty<DemoNote>();
    private IReadOnlyList<DemoNote> _serverNotes = Array.Empty<DemoNote>();

    private int _step;
    private string _narrative = string.Empty;
    private string? _outcome;
    private ConflictStrategy _strategy = ConflictStrategy.ClientWins;
    private string _noteId = string.Empty;

    protected override void OnInitialized()
    {
        _log.Changed += OnLogChanged;
        Build();
    }

    public void Dispose() => _log.Changed -= OnLogChanged;

    private async void OnLogChanged() => await InvokeAsync(StateHasChanged);

    private void Build()
    {
        _server = DemoWorkspace.CreateServer();
        _deviceA = new DeviceContext("Laptop", "laptop-lab", _server, _log);
        _deviceB = new DeviceContext("Phone", "phone-lab", _server, _log);
        _step = 0;
        _narrative = "Step 1 creates a note on the Laptop and syncs it to both devices and the cloud.";
        _outcome = null;
        _noteId = string.Empty;
    }

    private async Task Step1CreateAndShare()
    {
        await _deviceA.CreateNoteAsync("Q4 Plan", "Draft outline", "Work");
        await _deviceA.SyncAsync();
        await _deviceB.SyncAsync();

        var note = (await _deviceA.GetNotesAsync()).First();
        _noteId = note.Id;

        _step = 1;
        _narrative = "Both devices now hold the same note. Step 2 takes them offline and edits the note differently on each.";
        await RefreshAsync();
    }

    private async Task Step2EditOffline()
    {
        _deviceA.IsOnline = false;
        _deviceB.IsOnline = false;

        var a = (await _deviceA.GetNotesAsync()).First(n => n.Id == _noteId);
        a.Title = "Q4 Plan — Laptop";
        a.Body = "Draft outline\nLaptop: added revenue targets";
        await _deviceA.UpdateNoteAsync(a);

        var b = (await _deviceB.GetNotesAsync()).First(n => n.Id == _noteId);
        b.Title = "Q4 Plan — Phone";
        b.Body = "Draft outline\nPhone: added hiring plan";
        await _deviceB.UpdateNoteAsync(b);

        _step = 2;
        _narrative = "Two divergent edits exist. Choose how the Phone should resolve, then run step 3: " +
                     "the Laptop syncs first and wins the server, then the Phone syncs and hits a conflict.";
        await RefreshAsync();
    }

    private async Task Step3Resolve()
    {
        _deviceA.IsOnline = true;
        _deviceB.IsOnline = true;
        _deviceB.Strategy = _strategy;

        await _deviceA.SyncAsync(); // Laptop wins the race to the server
        await _deviceB.SyncAsync(); // Phone conflicts and resolves with the chosen strategy
        await _deviceA.SyncAsync(); // Laptop pulls the final converged state

        await RefreshAsync();

        var server = _serverNotes.First(n => n.Id == _noteId);
        _outcome = _strategy switch
        {
            ConflictStrategy.ClientWins => $"Phone's edit won. The cloud title is now \"{server.Title}\" — the Phone re-pushed its version over the Laptop's.",
            ConflictStrategy.ServerWins => $"The Laptop's edit was kept (\"{server.Title}\") and the Phone discarded its local change.",
            ConflictStrategy.LastWriteWins => $"The newer timestamp won. The cloud title is \"{server.Title}\".",
            ConflictStrategy.FieldMerge => $"Fields were merged. Title \"{server.Title}\"; both bodies were combined — see the cloud record.",
            _ => $"Resolved to \"{server.Title}\".",
        };
        _step = 3;
        _narrative = "All three are now converged on the same state. Reset to try another strategy.";
    }

    private void Reset()
    {
        _log.Clear();
        Build();
    }

    private async Task RefreshAsync()
    {
        _notesA = await _deviceA.GetNotesAsync(includeDeleted: true);
        _notesB = await _deviceB.GetNotesAsync(includeDeleted: true);
        _serverNotes = _server.Snapshot(includeDeleted: true);
    }

    private RenderFragment RenderNotes(IReadOnlyList<DemoNote> notes) => builder =>
    {
        if (notes.Count == 0)
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "empty");
            builder.AddContent(2, "—");
            builder.CloseElement();
            return;
        }

        var seq = 3;
        foreach (var note in notes)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "lab-note" + (note.Deleted ? " deleted" : string.Empty));

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "lab-note-title");
            builder.AddContent(seq++, string.IsNullOrEmpty(note.Title) ? "(untitled)" : note.Title);
            builder.CloseElement();

            builder.OpenElement(seq++, "pre");
            builder.AddAttribute(seq++, "class", "lab-note-body");
            builder.AddContent(seq++, note.Body);
            builder.CloseElement();

            builder.OpenComponent<HlcBadge>(seq++);
            builder.AddComponentParameter(seq++, nameof(HlcBadge.Timestamp), note.UpdatedAt);
            builder.CloseComponent();

            builder.CloseElement();
        }
    };
}
