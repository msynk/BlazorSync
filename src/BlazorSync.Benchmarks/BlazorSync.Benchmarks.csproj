<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Description>BenchmarkDotNet measurements of the ADR-012 workloads (docs/benchmarks.md). Run: dotnet run -c Release --project src/BlazorSync.Benchmarks -- --filter *</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorSync\BlazorSync.csproj" />
    <ProjectReference Include="..\BlazorSync.Storage.Sqlite\BlazorSync.Storage.Sqlite.csproj" />
  </ItemGroup>

</Project>
