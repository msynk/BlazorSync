@using Bsync.Blazor
@implements IDisposable
@inject ISyncCollection<Note> Notes

@* Works in every render mode: it only depends on ISyncCollection<Note>. The host decides whether that is a
   local replica (WebAssembly) or the server itself (Interactive Server, prerendering). *@
<section data-testid="notes-panel">
    <p>
        Running on <strong data-testid="host">@Notes.Capabilities.Host</strong>
        (<span data-testid="renderer">@RendererInfo.Name</span>, @(RendererInfo.IsInteractive ? "interactive" : "not interactive yet")).
        <span data-testid="status">@StatusText</span>
        · <span data-testid="pending">@Notes.Status.Pending</span> unsynced
    </p>
    <p>
        @if (Notes.Capabilities.DurableOfflineWrites)
        {
            <text>Notes are saved on this device first and uploaded when possible.</text>
        }
        else
        {
            <text>Notes are saved directly on the server; this page needs a connection.</text>
        }
    </p>

    <form @onsubmit="AddAsync">
        <input data-testid="new-text" @bind="_text" @bind:event="oninput" placeholder="Write a note" aria-label="New note" disabled="@(!RendererInfo.IsInteractive)" />
        <button data-testid="add" type="submit" disabled="@(!RendererInfo.IsInteractive || string.IsNullOrWhiteSpace(_text))">Add</button>
    </form>
    <p data-testid="last-result">@_lastResult</p>

    @if (_conflicts.Count > 0)
    {
        <section data-testid="conflicts" aria-label="Conflicts">
            <p>These notes were changed here and elsewhere at the same time. Choose which version to keep.</p>
            <ul>
                @foreach (var conflict in _conflicts)
                {
                    <li data-testid="conflict" data-id="@conflict.Id">
                        Yours: <span data-testid="conflict-local">@Describe(conflict.Local)</span>
                        · Theirs: <span data-testid="conflict-server">@Describe(conflict.Server)</span>
                        <button type="button" data-testid="keep-mine" disabled="@(!RendererInfo.IsInteractive)" @onclick="() => KeepMineAsync(conflict)">Keep mine</button>
                        <button type="button" data-testid="keep-theirs" disabled="@(!RendererInfo.IsInteractive)" @onclick="() => KeepTheirsAsync(conflict.Id)">Keep theirs</button>
                    </li>
                }
            </ul>
        </section>
    }

    <ul>
        @foreach (var note in _notes)
        {
            <li data-testid="note" data-id="@note.Id">
                <span data-testid="note-text">@note.Text</span>
                @if (_editing == note.Id)
                {
                    <input data-testid="edit-text" @bind="_editText" @bind:event="oninput" aria-label="Edit note" />
                    <button type="button" data-testid="save-edit" disabled="@(!RendererInfo.IsInteractive)" @onclick="() => SaveEditAsync(note)">Save</button>
                }
                else
                {
                    <button type="button" data-testid="edit" disabled="@(!RendererInfo.IsInteractive)" @onclick="() => (_editing, _editText) = (note.Id, note.Text)">Edit</button>
                }
                @if (_itemStatus.GetValueOrDefault(note.Id) is { } item && item.State != SyncItemState.Synced)
                {
                    <em data-testid="note-status"> (@(item.State switch { SyncItemState.Pending => "not synced yet", SyncItemState.Conflicted => "conflict", _ => $"{item.State}: {item.Detail}" }))</em>
                    @if (item.State == SyncItemState.Rejected)
                    {
                        <button type="button" data-testid="retry" disabled="@(!RendererInfo.IsInteractive)" @onclick="() => RetryAsync(note.Id)">Retry</button>
                        <button type="button" data-testid="revert" disabled="@(!RendererInfo.IsInteractive)" @onclick="() => RevertAsync(note.Id)">Discard my change</button>
                    }
                }
                <button type="button" data-testid="delete" disabled="@(!RendererInfo.IsInteractive)" @onclick="() => DeleteAsync(note.Id)">Delete</button>
            </li>
        }
    </ul>
</section>

@code {
    private IReadOnlyList<Note> _notes = [];
    private IReadOnlyDictionary<string, SyncItemStatus> _itemStatus = new Dictionary<string, SyncItemStatus>();
    private IReadOnlyList<SyncDocumentConflict<Note>> _conflicts = [];
    private IDisposable? _subscription;
    private string? _text;
    private string? _lastResult;
    private string? _editing;
    private string? _editText;

    private string StatusText => Notes.Status.State switch
    {
        SyncState.Starting => "Starting",
        SyncState.Synced => Notes.Capabilities.WritesConfirmedByServer ? "Connected to the server" : "Synced",
        SyncState.Syncing => "Syncing",
        SyncState.Offline => "Offline - changes are saved on this device",
        SyncState.Follower => "Another tab is syncing",
        SyncState.AttentionRequired => $"Needs attention: {Notes.Status.Detail}",
        SyncState.Paused => "Paused",
        _ => "Stopped",
    };

    protected override async Task OnInitializedAsync()
    {
        _subscription = Notes.Subscribe(() => _ = InvokeAsync(ReloadAsync));
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var notes = await Notes.QueryAsync(new SyncQuery<Note> { Order = (a, b) => b.UpdatedAt.CompareTo(a.UpdatedAt), Limit = 200 });
        var status = new Dictionary<string, SyncItemStatus>();
        if (Notes.Capabilities.DurableOfflineWrites)
        {
            foreach (var note in notes)
            {
                if (await Notes.GetItemStatusAsync(note.Id) is { } item)
                {
                    status[note.Id] = item;
                }
            }
        }

        var conflicts = await Notes.GetConflictsAsync();
        (_notes, _itemStatus, _conflicts) = (notes, status, conflicts);
        StateHasChanged();
    }

    private async Task AddAsync()
    {
        if (!string.IsNullOrWhiteSpace(_text))
        {
            var result = await Notes.SaveAsync(new Note { Text = _text.Trim() });
            _lastResult = result.Confirmation.ToString();
            _text = null;
            await ReloadAsync();
        }
    }

    private async Task SaveEditAsync(Note note)
    {
        // A new object: the listed one may be shared with the collection's cache.
        var edited = new Note { Id = note.Id, Text = _editText?.Trim() ?? string.Empty, Unknown = note.Unknown };
        _lastResult = (await Notes.SaveAsync(edited)).Confirmation.ToString();
        _editing = null;
        await ReloadAsync();
    }

    private async Task DeleteAsync(string id)
    {
        _lastResult = (await Notes.DeleteAsync(id)).Confirmation.ToString();
        await ReloadAsync();
    }

    private async Task KeepMineAsync(SyncDocumentConflict<Note> conflict)
    {
        _lastResult = (await Notes.ResolveConflictAsync(conflict.Id, conflict.Local)).Confirmation.ToString();
        await ReloadAsync();
    }

    private async Task KeepTheirsAsync(string id)
    {
        await Notes.DiscardConflictAsync(id);
        await ReloadAsync();
    }

    private async Task RetryAsync(string id)
    {
        _lastResult = (await Notes.RetryAsync(id)).Confirmation.ToString();
        await ReloadAsync();
    }

    private async Task RevertAsync(string id)
    {
        await Notes.RevertAsync(id);
        await ReloadAsync();
    }

    private static string Describe(Note note) => note.Deleted ? "(deleted)" : note.Text;

    public void Dispose() => _subscription?.Dispose();
}
