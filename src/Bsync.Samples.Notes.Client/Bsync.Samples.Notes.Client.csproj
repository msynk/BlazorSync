<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <Description>Sample: an installable, offline-capable notes PWA (IndexedDB replica, HTTP sync, service-worker app shell).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bsync\Bsync.csproj" />
    <ProjectReference Include="..\Bsync.Storage.IndexedDb\Bsync.Storage.IndexedDb.csproj" />
    <ProjectReference Include="..\Bsync.Transport.Http\Bsync.Transport.Http.csproj" />
    <ProjectReference Include="..\Bsync.Samples.Shared\Bsync.Samples.Shared.csproj" />
  </ItemGroup>

</Project>
