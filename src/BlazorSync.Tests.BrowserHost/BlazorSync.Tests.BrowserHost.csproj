<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Description>Test harness: a Blazor WebAssembly app that runs BlazorSync store conformance and scripted replica scenarios in real browsers (driven by BlazorSync.Tests.Browser).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorSync\BlazorSync.csproj" />
    <ProjectReference Include="..\BlazorSync.Storage.IndexedDb\BlazorSync.Storage.IndexedDb.csproj" />
    <ProjectReference Include="..\BlazorSync.Transport.Http\BlazorSync.Transport.Http.csproj" />
    <ProjectReference Include="..\BlazorSync.Testing\BlazorSync.Testing.csproj" />
  </ItemGroup>

</Project>
