<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Description>Test helper: writes to a SQLite replica until it is killed, so tests can check durability after real process termination.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorSync\BlazorSync.csproj" />
    <ProjectReference Include="..\BlazorSync.Storage.Sqlite\BlazorSync.Storage.Sqlite.csproj" />
  </ItemGroup>

</Project>
